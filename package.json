{
  "name": "blackboard",
  "version": "0.3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariusom/blackboard.git"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "bun ./node_modules/vitest/vitest.mjs run",
    "test:watch": "bun ./node_modules/vitest/vitest.mjs",
    "mcp": "bun src/mcp-main.ts",
    "mcp:dev": "bun --hot src/mcp-main.ts",
    "bump": "bun scripts/bump-version.ts",
    "postinstall": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^4.0.4",
    "@gpuix/native": "0.10.0",
    "effect": "^4.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/tsgo": "^0.53.0",
    "@effect/vitest": "^4.0.4",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
