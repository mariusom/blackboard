{
  "name": "blackboard",
  "version": "0.0.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariusom/blackboard.git"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "bun test",
    "mcp": "bun src/mcp-main.ts",
    "mcp:dev": "bun --hot src/mcp-main.ts",
    "bump": "bun scripts/bump-version.ts",
    "postinstall": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^4.0.4",
    "@gpuix/native": "0.10.0",
    "@gpuix/react": "0.10.0",
    "effect": "^4.0.4",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.53.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
