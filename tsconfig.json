{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "unstableApiUsage": "off"
        }
      }
    ]
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*"]
}
